# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opencobol

# ── LangSmith (optional — enables agent tracing) ──────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=opencobol-ai

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=opencobol
POSTGRES_PASSWORD=opencobol
POSTGRES_DB=opencobol
DATABASE_URL=postgresql://opencobol:opencobol@localhost:5432/opencobol
POSTGRES_URL=postgresql://opencobol:opencobol@localhost:5432/opencobol

# ── Auth (JWT) ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-min-64-chars-random-string-please-generate-a-real-one
JWT_REFRESH_SECRET=change-me-different-secret-for-refresh-tokens-also-64-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=opencobol

# ── API ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
