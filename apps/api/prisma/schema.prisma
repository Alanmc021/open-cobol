generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ANALYST)
  apiKeys      ApiKey[]
  createdAt    DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(uuid())
  keyHash    String    @unique
  name       String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

enum Role {
  ADMIN
  DEVELOPER
  ANALYST
}
